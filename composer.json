{
    "name": "nightpost/laravel",
    "description": "Producer package for the Nightpost monitor: request profiles, error reports, slow queries, job/command telemetry and the monitor log channel for Laravel apps.",
    "license": "MIT",
    "type": "library",
    "keywords": ["monitoring", "observability", "profiling", "laravel"],
    "require": {
        "php": "^8.3",
        "illuminate/support": "^11.0|^12.0",
        "illuminate/config": "^11.0|^12.0",
        "illuminate/http": "^11.0|^12.0",
        "illuminate/database": "^11.0|^12.0",
        "illuminate/queue": "^11.0|^12.0",
        "illuminate/console": "^11.0|^12.0",
        "illuminate/events": "^11.0|^12.0",
        "monolog/monolog": "^3.0",
        "spiral-packages/profiler": "^1.0",
        "symfony/http-client": "^7.0"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0|^10.0",
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "Nightpost\\Laravel\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "NightpostTests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Nightpost\\Laravel\\NightpostMonitorServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable"
}
